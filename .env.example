# Copy this file into the environment-specific files used by dotenv-rails:
#   cp .env.example .env.development
#   cp .env.example .env.test

IPSTACK_ACCESS_KEY=your_ipstack_key_here
# Generate with: bundle exec rails secret
DEVISE_JWT_SECRET_KEY=replace_with_output_of_rails_secret
RAILS_MAX_THREADS=5
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DB name for .env.test check the db name adn append _test instead of _development
POSTGRES_DB=geolocations_api_development
